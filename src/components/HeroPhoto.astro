---
// Einstieg mit echtem Foto statt 3D-Szene: Bild, eine Zeile, zwei Knöpfe.
import { Image } from 'astro:assets';
import photo from '../assets/uploads/event-edited-01.webp';

const facts = ['48 h gereifter Teig', '500 °C', '90 Sek. pro Pizza'];
---

<section class="photoHero" aria-label="Einleitung">
  <Image
    class="photoHeroImg"
    src={photo}
    alt="Andrin und Maurice backen Pizza im Garten bei Sonnenuntergang"
    widths={[640, 1024, 1448]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="photoHeroShade" aria-hidden="true"></div>
  <div class="wrap photoHeroIn">
    <div class="kicker">pizza catering · luzern &amp; umgebung</div>
    <h1>eifach<br />e rondi sach.</h1>
    <p class="photoHeroLead">Handgemachte Pizza, frisch gebacken an eurem Anlass.</p>
    <div class="heroActions">
      <a class="btn btn--light" href="#anfrage">pizza anfragen</a>
      <a class="btn btn--ghost" href="#preise">unser angebot</a>
    </div>
    <ul class="photoHeroFacts">
      {facts.map((f) => <li>{f}</li>)}
    </ul>
  </div>
</section>

<style>
  .photoHero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(560px, 86svh, 820px);
    overflow: hidden;
    background: var(--ink);
    color: var(--cream);
  }
  .photoHeroImg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 38% 55%;
  }
  .photoHeroShade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(18, 18, 18, 0.82) 0%, rgba(18, 18, 18, 0.35) 45%, rgba(18, 18, 18, 0) 70%),
      linear-gradient(to right, rgba(18, 18, 18, 0.35), rgba(18, 18, 18, 0) 60%);
  }
  .photoHeroIn {
    position: relative;
    padding-block: 48px clamp(28px, 5vw, 48px);
  }
  .photoHeroIn h1 {
    font-size: clamp(56px, 10vw, 132px);
    line-height: 0.86;
    margin: 14px 0 18px;
  }
  .photoHeroLead {
    font-size: clamp(18px, 2vw, 22px);
    max-width: 30ch;
    margin: 0;
    color: rgba(243, 238, 228, 0.88);
  }
  .heroActions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }
  .btn--ghost {
    background: transparent;
    border-color: rgba(243, 238, 228, 0.7);
    color: var(--cream);
  }
  .btn--ghost:hover {
    background: var(--cream);
    color: var(--ink);
  }
  .photoHeroFacts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin: clamp(32px, 5vw, 56px) 0 0;
    padding: 18px 0 0;
    list-style: none;
    border-top: 1px solid rgba(243, 238, 228, 0.3);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(243, 238, 228, 0.8);
  }
  @media (max-width: 620px) {
    .photoHeroImg {
      object-position: 30% 50%;
    }
    .heroActions .btn {
      flex: 1 1 100%;
    }
  }
</style>
