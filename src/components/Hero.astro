---
import { Image, getImage } from 'astro:assets';
import heroPizza from '../assets/uploads/pizza-margherita.webp';
import logo from '../assets/brand/rondisach-logo.webp';
import pizzen from '../data/pizzen.json';
import { upload } from '../lib/images';

// Pizzen für die Handy-Animation: die ersten vier aus dem Menü (im Editor änderbar).
const loopSources = pizzen.pizzas
  .map((p) => upload(p.image))
  .filter((i): i is NonNullable<typeof i> => !!i)
  .slice(0, 4);
const loopPizzas = (await Promise.all(loopSources.map((src) => getImage({ src, width: 640, format: 'webp' })))).map((r) => r.src);
const loopWords = ['so lecker!', 'mmmh …', 'no eis?'];

// Texte, die während dem Spaziergang durch den Garten eingeblendet werden (Fortschritt von–bis).
const captions = [
  { from: 0.3, to: 0.44, kicker: 'eure gäste', text: 'Alle sitzen zusammen, essen, lachen.' },
  { from: 0.48, to: 0.64, kicker: 'pizza à discrétion', text: 'Es kommt laufend frisch Pizza nach.' },
  { from: 0.74, to: 0.95, kicker: 'und wir?', text: 'Wir stehen am Ofen und backen direkt vor Ort.' },
];
---

<!-- Die ganze Seite scrollt durch den Garten; ohne WebGL, auf dem Handy oder bei reduzierter Bewegung bleibt das statische Bild. -->
<section class="hero" data-mode="static" aria-label="Einleitung">
  <div class="heroSticky">
    <div class="veil" aria-hidden="true"></div>
    <div class="wrap heroGrid">
      <div class="heroText">
        <div class="kicker">pizza catering · luzern &amp; umgebung</div>
        <h1>eifach<br class="brDesk" /> e <span class="hl">rondi</span><br class="brMob" /> sach.</h1>
        <p class="heroLead">Das könnte euer nächster Anlass sein: handgemachte Pizza, direkt vor euren Gästen gebacken.</p>
        <p class="heroLeadShort">Pizza Catering für Luzern und Umgebung.</p>
        <div class="heroActions">
          <a class="btn" href="#anfrage">pizza anfragen</a>
          <a class="btn btn--outline" href="#preise">unser angebot</a>
        </div>
      </div>

      <div class="heroStatic">
        <Image class="heroPizza" src={heroPizza} alt="Neapolitanische Margherita von rondisach" widths={[420, 640, 900]} sizes="(max-width: 920px) 90vw, 540px" loading="eager" fetchpriority="high" />
        <Image class="heroLogo" src={logo} alt="rondisach Pizza Catering" widths={[240, 480]} sizes="240px" loading="eager" />
        <div class="stamp">handgemacht · vor ort</div>
        <!-- Handy: kleine Pizza-Animation (Schaufel, Dampf, Hände holen sich die Stücke) -->
        <div class="loop" aria-hidden="true" data-pizzas={JSON.stringify(loopPizzas)} data-words={JSON.stringify(loopWords)}>
          <div class="loopPizza">
            {Array.from({ length: 6 }, (_, i) => (
              <div class="slice" style={`--i:${i}`}><img alt="" decoding="async" /></div>
            ))}
          </div>
          <svg class="peel" viewBox="0 0 200 330" aria-hidden="true">
            <defs>
              <pattern id="holes" width="12" height="12" patternUnits="userSpaceOnUse">
                <circle cx="6" cy="6" r="2.2" fill="#9a9a96" />
              </pattern>
            </defs>
            <rect x="88" y="190" width="24" height="140" rx="10" fill="#8a5a36" />
            <rect x="92" y="176" width="16" height="30" rx="4" fill="#b9b9b4" />
            <path d="M14 20 Q14 6 28 6 H172 Q186 6 186 20 V170 Q186 186 170 188 L112 196 H88 L30 188 Q14 186 14 170 Z" fill="#d9d9d4" stroke="#b5b5b0" stroke-width="2" />
            <path d="M24 18 H176 V172 L112 184 H88 L24 172 Z" fill="url(#holes)" opacity=".55" />
          </svg>
          <svg class="steam" viewBox="0 0 120 80" aria-hidden="true">
            <path d="M30 78 C18 62 42 52 30 36 C20 22 38 12 32 2" />
            <path d="M60 78 C48 60 72 50 60 34 C50 20 68 10 62 0" />
            <path d="M90 78 C78 62 102 52 90 36 C80 22 98 12 92 2" />
          </svg>
          <div class="arms"></div>
          <div class="word"></div>
        </div>
      </div>

      <div class="stage">
        <canvas class="heroCanvas" aria-hidden="true"></canvas>
        <div class="captions" aria-hidden="true">
          {
            captions.map((c) => (
              <div class="caption" data-from={c.from} data-to={c.to}>
                <div class="kicker">{c.kicker}</div>
                <p>{c.text}</p>
              </div>
            ))
          }
        </div>
        <!-- Knopf, der am Stand «klebt» und mit der Kamera mitwandert -->
        <a class="standCta" href="#anfrage" tabindex="-1"><span class="pulse" aria-hidden="true"></span>Jetzt Termin anfragen</a>
        <div class="scrollHint" aria-hidden="true"><span>scrollen</span></div>
      </div>
    </div>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('.hero');
  const canvas = hero?.querySelector<HTMLCanvasElement>('.heroCanvas');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  // Die Animation startet nicht ganz hinten im Garten, sondern schon ein Stück weiter vorne.
  const START = 0.22;

  function webglOk() {
    try {
      const c = document.createElement('canvas');
      return !!(c.getContext('webgl2') || c.getContext('webgl'));
    } catch {
      return false;
    }
  }

  async function init() {
    // Auf dem Handy bleibt das statische Bild – schneller und schont den Akku.
    const phone = window.matchMedia('(max-width: 760px)').matches;
    if (!hero || !canvas || reduce.matches || phone || !webglOk()) return;
    const { createHeroScene } = await import('../scripts/hero/scene');
    const text = hero.querySelector<HTMLElement>('.heroText')!;
    const veil = hero.querySelector<HTMLElement>('.veil')!;
    const stage = hero.querySelector<HTMLElement>('.stage')!;
    const sticky = hero.querySelector<HTMLElement>('.heroSticky')!;
    const captions = Array.from(hero.querySelectorAll<HTMLElement>('.caption'));
    const standCta = hero.querySelector<HTMLElement>('.standCta')!;

    const scene = createHeroScene(canvas, (p, anchor) => {
      // Einleitung blendet beim Losgehen aus
      const introOut = Math.min(1, Math.max(0, (p - START - 0.01) / 0.08));
      text.style.opacity = veil.style.opacity = String(1 - introOut);
      text.style.transform = `translateY(${-introOut * 24}px)`;
      text.style.pointerEvents = introOut > 0.5 ? 'none' : '';
      for (const c of captions) {
        const from = Number(c.dataset.from);
        const to = Number(c.dataset.to);
        const fade = 0.04;
        const o = Math.min(Math.max((p - from) / fade, 0), 1, Math.max((to - p) / fade, 0));
        c.style.opacity = String(o);
        c.style.transform = `translateY(${(1 - o) * 16}px)`;
      }
      const show = p > 0.66 && anchor.visible;
      standCta.classList.toggle('show', show);
      standCta.tabIndex = show ? 0 : -1;
      // Nie oben aus der Animation herausragen lassen
      standCta.style.transform = `translate(${anchor.x}px, ${Math.max(anchor.y, 76)}px) translate(-50%, -100%)`;
    });
    scene.jump(START);
    hero.dataset.mode = '3d';
    if (import.meta.env.DEV) (window as unknown as { __hero: typeof scene }).__hero = scene;

    // Der Scroll-Fortschritt durch den hohen Abschnitt steuert die Animation.
    const update = () => {
      const rect = hero.getBoundingClientRect();
      const travel = rect.height - sticky.offsetHeight;
      const prog = travel > 0 ? Math.min(1, Math.max(0, -rect.top / travel)) : 0;
      scene.setProgress(START + prog * (1 - START));
      hero.classList.toggle('scrolled', prog > 0.02);
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);

    // Nur rendern, solange die Animation sichtbar ist – spart Akku.
    new IntersectionObserver(([entry]) => (entry.isIntersecting ? scene.start() : scene.stop())).observe(stage);
  }

  init().catch((err) => {
    console.warn('[rondisach] 3D-Hero konnte nicht geladen werden', err);
    if (hero) hero.dataset.mode = 'static';
  });
</script>

<script>
  // ---------- Handy: Pizza-Animation im Loop ----------
  const loop = document.querySelector<HTMLElement>('.loop');
  const heroEl = document.querySelector<HTMLElement>('.hero');
  const motionOk = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const phoneMq = window.matchMedia('(max-width: 760px)');

  if (loop && heroEl && motionOk && phoneMq.matches) startLoop(loop, heroEl);

  function startLoop(loop: HTMLElement, hero: HTMLElement) {
    const pizzas: string[] = JSON.parse(loop.dataset.pizzas || '[]');
    const words: string[] = JSON.parse(loop.dataset.words || '[]');
    if (!pizzas.length) return;
    const pizza = loop.querySelector<HTMLElement>('.loopPizza')!;
    const slices = Array.from(loop.querySelectorAll<HTMLElement>('.slice'));
    const imgs = slices.map((s) => s.querySelector('img')!);
    const peel = loop.querySelector<SVGElement>('.peel')!;
    const steam = Array.from(loop.querySelectorAll<SVGPathElement>('.steam path'));
    const armsBox = loop.querySelector<HTMLElement>('.arms')!;
    const word = loop.querySelector<HTMLElement>('.word')!;

    // Bilder vorladen
    pizzas.forEach((src) => (new Image().src = src));

    // Sechs Arme, jeder holt sich ein Stück. Farben passend zur Marke.
    const sleeves = ['#b83c2e', '#121212', '#d9a441', '#4f6b52', '#3d5a80', '#c97b63'];
    const skins = ['#f1c7a5', '#c68b62', '#8d5a3b', '#e8b48f', '#a86f4c', '#f5d2b8'];
    const arms = slices.map((_, i) => {
      const el = document.createElement('div');
      el.className = 'arm';
      el.innerHTML = `<svg viewBox="0 0 260 40" preserveAspectRatio="none"><path d="M44 8 L260 6 V34 L44 32 Z" fill="${sleeves[i]}"/><rect x="40" y="7" width="10" height="26" rx="3" fill="rgba(255,255,255,.35)"/><path d="M42 11 C30 9 16 8 8 12 C2 15 2 25 8 28 C16 32 30 31 42 29 Z" fill="${skins[i]}"/><path d="M30 10 C24 4 16 3 13 6 C11 9 16 11 22 12 Z" fill="${skins[i]}"/></svg>`;
      armsBox.appendChild(el);
      return el;
    });

    const angle = (i: number) => i * 60 - 60; // Mitte des Stücks (Grad, 0 = rechts)
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const anim = (el: Element, kf: Keyframe[], o: KeyframeAnimationOptions) => el.animate(kf, { fill: 'forwards', ...o }).finished;
    let visible = true;
    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(loop);
    const waitVisible = async () => {
      while (!visible || document.hidden) await sleep(400);
    };

    async function cycle(n: number) {
      const R = pizza.offsetWidth / 2;
      loop.style.setProperty('--pw', `${R * 2}px`);
      imgs.forEach((img) => (img.src = pizzas[n % pizzas.length]));
      slices.forEach((s) => s.getAnimations().forEach((a) => a.cancel()));
      arms.forEach((a) => a.getAnimations().forEach((x) => x.cancel()));
      word.getAnimations().forEach((a) => a.cancel());
      word.textContent = words[n % words.length] || '';

      // 1. Pizza kommt auf der Schaufel herein
      const from = 'translate(-95%, 85%) rotate(-28deg)';
      await Promise.all([
        anim(pizza, [{ transform: from, opacity: 1 }, { transform: 'none', opacity: 1 }], { duration: 950, easing: 'cubic-bezier(.2,.8,.2,1)' }),
        anim(peel, [{ transform: from, opacity: 1 }, { transform: 'none', opacity: 1 }], { duration: 950, easing: 'cubic-bezier(.2,.8,.2,1)' }),
      ]);
      // 2. Schaufel zieht schnell weg, Pizza bleibt liegen
      await Promise.all([
        anim(peel, [{ transform: 'none', opacity: 1 }, { transform: 'translate(-120%, 110%) rotate(-28deg)', opacity: 1, offset: 0.85 }, { transform: 'translate(-130%, 120%) rotate(-28deg)', opacity: 0 }], { duration: 420, easing: 'cubic-bezier(.6,0,.9,.4)' }),
        anim(pizza, [{ transform: 'scale(1.03)' }, { transform: 'scale(.98)' }, { transform: 'none' }], { duration: 500, delay: 260 }),
      ]);

      // 3. Dampf steigt auf
      steam.forEach((p, i) =>
        p.animate(
          [
            { opacity: 0, transform: 'translateY(14px)' },
            { opacity: 0.7, offset: 0.4 },
            { opacity: 0, transform: 'translateY(-26px)' },
          ],
          { duration: 1800, delay: i * 220, easing: 'ease-out' },
        ),
      );
      await sleep(1500);

      // 4. Hände kommen und holen sich die Stücke
      const grab = R * 0.5;
      await Promise.all(
        arms.map((a, i) =>
          anim(a, [{ transform: `rotate(${angle(i)}deg) translateX(${R * 3}px)` }, { transform: `rotate(${angle(i)}deg) translateX(${grab}px)` }], {
            duration: 520,
            delay: i * 110,
            easing: 'cubic-bezier(.2,.8,.2,1)',
          }),
        ),
      );
      await sleep(180);
      const away = R * 3.2;
      await Promise.all(
        slices.flatMap((s, i) => {
          const a = (angle(i) * Math.PI) / 180;
          const opt = { duration: 650, delay: i * 90, easing: 'cubic-bezier(.5,0,.8,.4)' };
          return [
            anim(s, [{ transform: 'none' }, { transform: `translate(${Math.cos(a) * away}px, ${Math.sin(a) * away}px)` }], opt),
            anim(arms[i], [{ transform: `rotate(${angle(i)}deg) translateX(${grab}px)` }, { transform: `rotate(${angle(i)}deg) translateX(${grab + away}px)` }], opt),
          ];
        }),
      );

      // 5. Kurzer Spruch
      await anim(word, [{ opacity: 0, transform: 'translate(-50%,-50%) rotate(-4deg) scale(.6)' }, { opacity: 1, transform: 'translate(-50%,-50%) rotate(-4deg) scale(1.08)', offset: 0.7 }, { opacity: 1, transform: 'translate(-50%,-50%) rotate(-4deg) scale(1)' }], { duration: 380, easing: 'ease-out' });
      await sleep(1100);
      await anim(word, [{ opacity: 1 }, { opacity: 0 }], { duration: 300 });
    }

    hero.classList.add('looping');
    (async () => {
      for (let n = 0; ; n++) {
        await waitVisible();
        try {
          await cycle(n);
        } catch {
          await sleep(500);
        }
      }
    })();
  }
</script>

<style>
  .hero {
    position: relative;
  }
  .heroSticky {
    position: relative;
    padding-block: clamp(28px, 5vw, 56px) 24px;
  }
  .heroGrid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 32px;
    align-items: center;
  }
  h1 {
    font-size: clamp(56px, 9vw, 124px);
    line-height: 0.84;
    letter-spacing: -0.07em;
    margin: 16px 0 26px;
  }
  .heroLead {
    font-size: clamp(18px, 2vw, 23px);
    line-height: 1.4;
    color: var(--ink-2);
    max-width: 30ch;
    margin: 0 0 28px;
  }
  .heroActions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* Statische Variante (ohne JS, ohne WebGL oder bei reduzierter Bewegung) */
  .heroStatic {
    position: relative;
    min-height: clamp(380px, 46vw, 560px);
  }
  .heroPizza {
    position: absolute;
    width: min(88%, 540px);
    right: 0;
    top: 2%;
    transform: rotate(5deg);
    filter: drop-shadow(0 24px 24px rgba(0, 0, 0, 0.15));
  }
  .heroLogo {
    position: absolute;
    width: 42%;
    left: 2%;
    bottom: 4%;
    transform: rotate(-2deg);
  }
  .stamp {
    position: absolute;
    right: 2%;
    bottom: 3%;
    background: var(--accent);
    color: #fff;
    border: 2px solid var(--ink);
    border-radius: 999px;
    padding: 10px 16px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transform: rotate(3deg);
  }
  .stage,
  .veil {
    display: none;
  }
  .hero:not([data-mode='static']) .heroStatic {
    display: none;
  }

  /* Gemeinsame Teile der Animation */
  .heroCanvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .captions {
    position: absolute;
    left: var(--cap-x);
    right: var(--cap-x);
    bottom: var(--cap-y);
    pointer-events: none;
  }
  .caption {
    position: absolute;
    left: 0;
    bottom: 0;
    max-width: min(520px, 100%);
    padding: 16px 20px;
    border-radius: 20px;
    background: rgba(18, 18, 18, 0.78);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--cream);
    opacity: 0;
    will-change: opacity, transform;
  }
  .caption .kicker {
    color: #f6c48a;
  }
  .caption p {
    margin: 6px 0 0;
    font-family: var(--font-display);
    font-size: var(--cap-size);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .standCta {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 26px 14px 20px;
    border: 2px solid var(--cream);
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(16px, 1.6vw, 20px);
    letter-spacing: -0.01em;
    white-space: nowrap;
    text-decoration: none;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.3);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease, background-color 0.2s ease, color 0.2s ease;
    will-change: transform;
  }
  /* Spitze nach unten, zeigt auf den Stand */
  .standCta::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -9px;
    width: 14px;
    height: 14px;
    background: inherit;
    border-right: 2px solid var(--cream);
    border-bottom: 2px solid var(--cream);
    transform: translateX(-50%) rotate(45deg);
  }
  .standCta.show {
    opacity: 1;
    pointer-events: auto;
  }
  .standCta:hover {
    background: var(--ink);
  }
  .pulse {
    position: relative;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #fff;
  }
  .pulse::after {
    content: '';
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    border: 2px solid #fff;
    animation: pulse 1.6s ease-out infinite;
  }
  @keyframes pulse {
    from {
      transform: scale(0.6);
      opacity: 1;
    }
    to {
      transform: scale(1.8);
      opacity: 0;
    }
  }
  .scrollHint {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: opacity 0.3s ease;
  }
  .scrollHint span::after {
    content: ' ↓';
  }
  .hero.scrolled .scrollHint {
    opacity: 0;
  }

  /* ---------- Animation (Vollbild) ---------- */
  .hero[data-mode='3d'] {
    height: 287vh;
  }
  .hero[data-mode='3d'] .heroSticky {
    position: sticky;
    top: var(--nav-h);
    height: calc(100svh - var(--nav-h));
    padding: 0;
    overflow: hidden;
    display: flex;
    align-items: flex-start;
  }
  .hero[data-mode='3d'] .heroGrid {
    position: static;
    display: block;
    padding-top: clamp(28px, 6vh, 72px);
  }
  .hero[data-mode='3d'] .stage {
    display: block;
    position: absolute;
    inset: 0;
    --cap-x: var(--gutter);
    --cap-y: clamp(40px, 9vh, 88px);
    --cap-size: clamp(22px, 2.6vw, 32px);
  }
  /* Unten weich in die Seite überblenden */
  .hero[data-mode='3d'] .stage::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 90px;
    background: linear-gradient(180deg, rgba(243, 238, 228, 0), var(--cream));
    pointer-events: none;
  }
  /* Heller Schleier über die ganze Höhe, damit der Text gut lesbar ist */
  .hero[data-mode='3d'] .veil {
    display: block;
    position: absolute;
    inset: 0 auto 0 0;
    z-index: 1;
    width: min(72%, 1100px);
    background: linear-gradient(90deg, rgba(243, 238, 228, 0.92) 0%, rgba(243, 238, 228, 0.82) 45%, rgba(243, 238, 228, 0));
    pointer-events: none;
    will-change: opacity;
  }
  .hero[data-mode='3d'] .heroText {
    position: relative;
    z-index: 2;
    max-width: 640px;
    will-change: opacity, transform;
  }
  .hero[data-mode='3d'] .captions {
    z-index: 3;
  }
  .hero[data-mode='3d'] .scrollHint {
    bottom: 22px;
    z-index: 3;
  }

  @media (max-width: 920px) {
    .heroGrid {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .hero[data-mode='3d'] {
      height: 256vh;
    }
    .hero[data-mode='3d'] h1 {
      font-size: clamp(48px, 13vw, 84px);
    }
    .hero[data-mode='3d'] .heroLead {
      font-size: 17px;
    }
  }
  @media (max-width: 620px) {
    .stamp {
      font-size: 10px;
    }
    /* Handy: Bild kleiner, damit gleich darunter die Fakten und Termine sichtbar werden */
    .heroSticky {
      padding-block: 24px 8px;
    }
    h1 {
      margin: 12px 0 18px;
    }
    .heroLead {
      font-size: 17px;
      margin-bottom: 22px;
    }
    .heroActions {
      display: grid;
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .heroActions .btn {
      justify-content: center;
    }
    .heroStatic {
      min-height: 0;
      aspect-ratio: 1 / 0.82;
    }
    .heroPizza {
      width: 80%;
    }
    .heroLogo {
      width: 38%;
    }
    .hero[data-mode='3d'] .veil {
      width: 100%;
      background: linear-gradient(180deg, rgba(243, 238, 228, 0.92) 0%, rgba(243, 238, 228, 0.85) 55%, rgba(243, 238, 228, 0) 80%);
    }
  }
  /* ---------- Handy-Animation ---------- */
  .loop,
  .heroLeadShort,
  .brMob {
    display: none;
  }
  .loop {
    position: absolute;
    inset: 0;
    --p: min(70%, 290px);
  }
  .loopPizza {
    position: absolute;
    left: 50%;
