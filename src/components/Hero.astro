---
import { Image } from 'astro:assets';
import heroPizza from '../assets/uploads/pizza-margherita.webp';
import logo from '../assets/brand/rondisach-logo.webp';

// Texte, die während dem Spaziergang durch den Garten eingeblendet werden (Fortschritt von–bis).
const captions = [
  { from: 0.3, to: 0.44, kicker: 'eure gäste', text: 'Alle sitzen zusammen, essen, lachen.' },
  { from: 0.48, to: 0.64, kicker: 'pizza à discrétion', text: 'Es kommt laufend frisch Pizza nach.' },
  { from: 0.745, to: 0.815, kicker: 'und wir?', text: 'Wir stehen am Ofen und backen direkt vor Ort.' },
  { from: 0.83, to: 0.895, kicker: '500 grad', text: 'Nach 90 Sekunden ist sie fertig.' },
];
---

<!-- Die ganze Seite scrollt durch den Garten; ohne WebGL, auf dem Handy oder bei reduzierter Bewegung bleibt das statische Bild. -->
<section class="hero" data-mode="static" aria-label="Einleitung">
  <!-- Entscheidet noch vor dem ersten Bild, ob die Animation kommt. So erscheint am Desktop nie kurz die Handyansicht,
       sondern sofort ein Standbild des Gartens, das in die echte Szene überblendet. -->
  <script is:inline>
    (function () {
      var hero = document.currentScript.parentElement;
      try {
        if (window.matchMedia('(max-width: 760px)').matches || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var c = document.createElement('canvas');
        if (c.getContext('webgl2') || c.getContext('webgl')) hero.dataset.mode = 'loading';
      } catch (e) {}
    })();
  </script>
  <div class="heroSticky">
    <div class="veil" aria-hidden="true"></div>
    <div class="wrap heroGrid">
      <div class="heroText">
        <div class="kicker">pizza catering · luzern &amp; umgebung</div>
        <h1>eifach<br />e rondi sach.</h1>
        <p class="heroLead">Das könnte euer nächster Anlass sein: handgemachte Pizza, direkt vor euren Gästen gebacken.</p>
        <div class="heroActions">
          <a class="btn" href="#anfrage">pizza anfragen</a>
          <a class="btn btn--outline" href="#preise">unser angebot</a>
        </div>
      </div>

      <div class="heroStatic">
        <!-- Die Pizza rollt herein und dreht sich beim Scrollen mit (--spin); der Schatten bleibt dabei ruhig liegen. -->
        <div class="pizzaWrap">
          <Image class="heroPizza" src={heroPizza} alt="Neapolitanische Margherita von rondisach" widths={[420, 640, 900]} sizes="(max-width: 920px) 100vw, 540px" loading="eager" fetchpriority="high" />
        </div>
        <Image class="heroLogo" src={logo} alt="rondisach Pizza Catering" widths={[240, 480]} sizes="240px" loading="eager" />
        <div class="stamp">handgemacht · vor ort</div>
      </div>

      <div class="stage">
        <canvas class="heroCanvas" aria-hidden="true"></canvas>
        <div class="captions" aria-hidden="true">
          {
            captions.map((c) => (
              <div class="caption" data-from={c.from} data-to={c.to}>
                <div class="kicker">{c.kicker}</div>
                <p>{c.text}</p>
              </div>
            ))
          }
        </div>
        <!-- Knopf, der am Stand «klebt» und mit der Kamera mitwandert -->
        <a class="standCta" href="#anfrage" tabindex="-1"><span class="pulse" aria-hidden="true"></span>Jetzt Termin anfragen</a>
        <!-- Finale: Die fertige Pizza schwebt rechts im Bild, daneben die Einladung -->
        <div class="finale">
          <div class="kicker">frisch aus dem ofen</div>
          <p>Die nächste backen wir für euch.</p>
          <a class="btn finaleBtn" href="#anfrage" tabindex="-1">Jetzt Termin anfragen</a>
        </div>
        <div class="scrollHint" aria-hidden="true"><span>scrollen</span></div>
      </div>
    </div>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('.hero');
  const canvas = hero?.querySelector<HTMLCanvasElement>('.heroCanvas');
    // Die Animation startet nicht ganz hinten im Garten, sondern schon ein Stück weiter vorne.
  const START = 0.22;
  // Bis hierhin (Fortschritt der Szene) dauert der Spaziergang, danach kommt der Ofen.
  const WALK_END = 0.74;
  // Anteil des Scrollwegs für den Spaziergang; der Rest gehört dem Ofen und dem kurzen Halt am Schluss.
  const WALK_SHARE = 0.52;

  // Leichte Variante (Handy, kein WebGL): Die Pizza dreht sich beim Scrollen mit.
  function spinOnScroll() {
    const wrap = hero?.querySelector<HTMLElement>('.pizzaWrap');
    if (!hero || !wrap || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    let queued = false;
    const update = () => {
      queued = false;
      // Nur solange die Pizza im Bild ist
      if (hero.dataset.mode !== 'static' || hero.getBoundingClientRect().bottom < 0) return;
      wrap.style.setProperty('--spin', `${(window.scrollY * 0.16).toFixed(1)}deg`);
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!queued) {
          queued = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
  }

  async function init() {
    // Auf dem Handy bleibt das leichte Bild – schneller und schont den Akku. Entschieden hat das Skript oben im Abschnitt.
    if (!hero || !canvas || hero.dataset.mode !== 'loading') return spinOnScroll();
    const { createHeroScene } = await import('../scripts/hero/scene');
    const { default: pizzaPhoto } = await import('../assets/uploads/pizza-margherita.webp?url');
    const text = hero.querySelector<HTMLElement>('.heroText')!;
    const veil = hero.querySelector<HTMLElement>('.veil')!;
    const stage = hero.querySelector<HTMLElement>('.stage')!;
    const sticky = hero.querySelector<HTMLElement>('.heroSticky')!;
    const captions = Array.from(hero.querySelectorAll<HTMLElement>('.caption'));
    const standCta = hero.querySelector<HTMLElement>('.standCta')!;
    const finale = hero.querySelector<HTMLElement>('.finale')!;
    const finaleBtn = hero.querySelector<HTMLAnchorElement>('.finaleBtn')!;

    // Stile nur schreiben, wenn sich der Wert ändert – sonst muss der Browser in jedem Bild neu zusammensetzen.
    const last = new WeakMap<HTMLElement, Record<string, string>>();
    const set = (el: HTMLElement, prop: 'opacity' | 'transform' | 'pointerEvents', value: string) => {
      let cache = last.get(el);
      if (!cache) last.set(el, (cache = {}));
      if (cache[prop] === value) return;
      cache[prop] = value;
      el.style[prop] = value;
    };

    const scene = createHeroScene(canvas, (p, anchor) => {
      // Einleitung blendet beim Losgehen aus
      const introOut = Math.min(1, Math.max(0, (p - START - 0.01) / 0.08));
      const introOpacity = (1 - introOut).toFixed(2);
      set(text, 'opacity', introOpacity);
      set(veil, 'opacity', introOpacity);
      set(text, 'transform', `translateY(${Math.round(-introOut * 24)}px)`);
      set(text, 'pointerEvents', introOut > 0.5 ? 'none' : '');
      for (const c of captions) {
        const from = Number(c.dataset.from);
        const to = Number(c.dataset.to);
        const fade = 0.04;
        const o = Math.min(Math.max((p - from) / fade, 0), 1, Math.max((to - p) / fade, 0));
        set(c, 'opacity', o.toFixed(2));
        set(c, 'transform', `translateY(${Math.round((1 - o) * 16)}px)`);
      }
      // Der Knopf klebt am Stand, bis die Kamera zum Ofen fährt; im Finale steht er neben der Pizza.
      const oven = (p - WALK_END) / (1 - WALK_END);
      const show = p > 0.66 && oven < 0.05 && anchor.visible;
      const end = oven > 0.84;
      finale.classList.toggle('show', end);
      finaleBtn.tabIndex = end ? 0 : -1;
      standCta.classList.toggle('show', show);
      standCta.tabIndex = show ? 0 : -1;
      // Nie oben aus der Animation herausragen lassen
      if (show) set(standCta, 'transform', `translate(${anchor.x.toFixed(1)}px, ${Math.max(anchor.y, 76).toFixed(1)}px) translate(-50%, -100%)`);
        }, pizzaPhoto);
    scene.jump(START);
    if (import.meta.env.DEV) (window as unknown as { __hero: typeof scene }).__hero = scene;
    // Mit ?fps in der Adresse zeigt eine kleine Anzeige Bildrate, Auflösung und Zeichenaufrufe.
    if (new URLSearchParams(location.search).has('fps')) {
      const meter = document.createElement('div');
      meter.style.cssText = 'position:fixed;left:8px;bottom:8px;z-index:999;padding:6px 10px;border-radius:8px;background:#121212;color:#fff;font:600 12px/1.3 ui-monospace,monospace';
      document.body.append(meter);
      setInterval(() => {
        const i = scene.info();
        meter.textContent = `${Math.round(i.fps)} fps · ×${i.pixelRatio.toFixed(2)} · ${i.calls} calls`;
      }, 500);
    }

    // Der Scroll-Fortschritt durch den hohen Abschnitt steuert die Animation.
    const update = () => {
      const rect = hero.getBoundingClientRect();
      const travel = rect.height - sticky.offsetHeight;
      const prog = travel > 0 ? Math.min(1, Math.max(0, -rect.top / travel)) : 0;
      const p =
        prog < WALK_SHARE
          ? START + (prog / WALK_SHARE) * (WALK_END - START)
          : WALK_END + ((prog - WALK_SHARE) / (1 - WALK_SHARE)) * (1 - WALK_END);
      scene.setProgress(p);
      hero.classList.toggle('scrolled', prog > 0.02);
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);

    // Nur rendern, solange die Animation sichtbar ist – spart Akku.
    new IntersectionObserver(([entry]) => (entry.isIntersecting ? scene.start() : scene.stop())).observe(stage);
    // Erst wenn die Szene wirklich gezeichnet ist, vom Standbild überblenden.
    scene.start();
    requestAnimationFrame(() => requestAnimationFrame(() => (hero.dataset.mode = '3d')));
  }

  init().catch((err) => {
    console.warn('[rondisach] 3D-Hero konnte nicht geladen werden', err);
    if (hero) hero.dataset.mode = 'static';
    spinOnScroll();
  });
</script>

<style>
  .hero {
    position: relative;
  }
  .heroSticky {
    position: relative;
    padding-block: clamp(28px, 5vw, 56px) 24px;
  }
  .heroGrid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 32px;
    align-items: center;
  }
  h1 {
    font-size: clamp(56px, 9vw, 124px);
    line-height: 0.84;
    letter-spacing: -0.07em;
    margin: 16px 0 26px;
  }
  .heroLead {
    font-size: clamp(18px, 2vw, 23px);
    line-height: 1.4;
    color: var(--ink-2);
    max-width: 30ch;
    margin: 0 0 28px;
  }
  .heroActions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* Statische Variante (ohne JS, ohne WebGL oder bei reduzierter Bewegung) */
  .heroStatic {
    position: relative;
    min-height: clamp(380px, 46vw, 560px);
  }
  .pizzaWrap {
    position: absolute;
    width: min(88%, 540px);
    aspect-ratio: 1;
    right: 0;
    top: 2%;
    --spin: 0deg;
  }
  /* Weicher Schatten unter der Pizza – eigenes Element, damit er sich nicht mitdreht */
  .pizzaWrap::before {
    content: '';
    position: absolute;
    inset: 9% 6% -3%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(40, 24, 10, 0.3), rgba(40, 24, 10, 0.16) 62%, rgba(40, 24, 10, 0) 100%);
  }
  .heroPizza {
    position: relative;
    width: 100%;
    transform: rotate(calc(5deg + var(--spin)));
    will-change: transform;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero[data-mode='static'] .heroPizza {
      animation: rollIn 1.1s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }
    .hero[data-mode='static'] .pizzaWrap::before {
      animation: fadeIn 0.6s ease 0.7s both;
    }
    .hero[data-mode='static'] .stamp {
      animation: popIn 0.5s cubic-bezier(0.3, 1.6, 0.5, 1) 0.8s both;
    }
    .hero[data-mode='static'] .heroLogo {
      animation: riseIn 0.5s ease 1s both;
    }
  }
  @keyframes rollIn {
    from {
      transform: translateX(75%) rotate(calc(100deg + var(--spin)));
    }
    to {
      transform: translateX(0) rotate(calc(5deg + var(--spin)));
    }
  }
  @keyframes fadeIn {
    from {
      opacity: 0;
    }
  }
  @keyframes popIn {
    from {
      opacity: 0;
      transform: scale(0.3) rotate(-18deg);
    }
  }
  @keyframes riseIn {
    from {
      opacity: 0;
      transform: translateY(14px) rotate(-2deg);
    }
  }
  .heroLogo {
    position: absolute;
    width: 42%;
    left: 2%;
    bottom: 4%;
    transform: rotate(-2deg);
  }
  .stamp {
    position: absolute;
    right: 2%;
    bottom: 3%;
    background: var(--accent);
    color: #fff;
    border: 2px solid var(--ink);
    border-radius: 999px;
    padding: 10px 16px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transform: rotate(3deg);
  }
  .stage,
  .veil {
    display: none;
  }
  .hero:not([data-mode='static']) .heroStatic {
    display: none;
  }

  /* Gemeinsame Teile der Animation */
  .heroCanvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 0.7s ease;
  }
  .hero[data-mode='3d'] .heroCanvas {
    opacity: 1;
  }
  .captions {
    position: absolute;
    left: var(--cap-x);
    right: var(--cap-x);
    bottom: var(--cap-y);
    pointer-events: none;
  }
  .caption {
    position: absolute;
    left: 0;
    bottom: 0;
    max-width: min(520px, 100%);
    padding: 16px 20px;
    border-radius: 20px;
    background: rgba(18, 18, 18, 0.86);
    color: var(--cream);
    opacity: 0;
    will-change: opacity, transform;
  }
  .caption .kicker {
    color: #f6c48a;
  }
  .caption p {
    margin: 6px 0 0;
    font-family: var(--font-display);
    font-size: var(--cap-size);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .standCta {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 26px 14px 20px;
    border: 2px solid var(--cream);
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(16px, 1.6vw, 20px);
    letter-spacing: -0.01em;
    white-space: nowrap;
    text-decoration: none;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.3);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease, background-color 0.2s ease, color 0.2s ease;
    will-change: transform;
  }
  /* Spitze nach unten, zeigt auf den Stand */
  .standCta::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -9px;
    width: 14px;
    height: 14px;
    background: inherit;
    border-right: 2px solid var(--cream);
    border-bottom: 2px solid var(--cream);
    transform: translateX(-50%) rotate(45deg);
  }
  .standCta.show {
    opacity: 1;
    pointer-events: auto;
  }
  .standCta:hover {
    background: var(--ink);
  }
  .finale {
    position: absolute;
    z-index: 4;
    left: var(--gutter);
    top: 50%;
    width: min(46%, 580px);
    padding: clamp(22px, 2.6vw, 36px);
    border-radius: var(--radius);
    background: rgba(18, 18, 18, 0.86);
    transform: translateY(calc(-50% + 20px));
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .finale.show {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(-50%);
  }
  .finale .kicker {
    color: #f6c48a;
  }
  .finale p {
    margin: 10px 0 26px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(36px, 4.6vw, 68px);
    line-height: 0.94;
    letter-spacing: -0.05em;
    color: var(--cream);
  }
  .finaleBtn {
    background: var(--accent);
    border-color: var(--cream);
    color: #fff;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.3);
  }
  .pulse {
    position: relative;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #fff;
  }
  .pulse::after {
    content: '';
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    border: 2px solid #fff;
    animation: pulse 1.6s ease-out infinite;
  }
  @keyframes pulse {
    from {
      transform: scale(0.6);
      opacity: 1;
    }
    to {
      transform: scale(1.8);
      opacity: 0;
    }
  }
  .scrollHint {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: opacity 0.3s ease;
  }
  .scrollHint span::after {
    content: ' ↓';
  }
  .hero.scrolled .scrollHint {
    opacity: 0;
  }

  /* ---------- Animation (Vollbild) ---------- */
  .hero:not([data-mode='static']) {
    height: 340vh;
  }
  .hero:not([data-mode='static']) .heroSticky {
    position: sticky;
    top: var(--nav-h);
    height: calc(100svh - var(--nav-h));
    padding: 0;
    overflow: hidden;
    display: flex;
    align-items: flex-start;
  }
  .hero:not([data-mode='static']) .heroGrid {
    position: static;
    display: block;
    padding-top: clamp(28px, 6vh, 72px);
  }
  .hero:not([data-mode='static']) .stage {
    display: block;
    position: absolute;
    inset: 0;
    --cap-x: var(--gutter);
    --cap-y: clamp(40px, 9vh, 88px);
    --cap-size: clamp(22px, 2.6vw, 32px);
    /* Standbild der Szene, sichtbar bis die Animation geladen ist */
    background: #e9b98a url('../assets/brand/hero-poster.webp') center / cover no-repeat;
  }
  /* Unten weich in die Seite überblenden */
  .hero:not([data-mode='static']) .stage::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 90px;
    background: linear-gradient(180deg, rgba(243, 238, 228, 0), var(--cream));
    pointer-events: none;
  }
  /* Heller Schleier über die ganze Höhe, damit der Text gut lesbar ist */
  .hero:not([data-mode='static']) .veil {
    display: block;
    position: absolute;
    inset: 0 auto 0 0;
    z-index: 1;
    width: min(72%, 1100px);
    background: linear-gradient(90deg, rgba(243, 238, 228, 0.92) 0%, rgba(243, 238, 228, 0.82) 45%, rgba(243, 238, 228, 0));
    pointer-events: none;
    will-change: opacity;
  }
  .hero:not([data-mode='static']) .heroText {
    position: relative;
    z-index: 2;
    max-width: 640px;
    will-change: opacity, transform;
  }
  .hero:not([data-mode='static']) .captions {
    z-index: 3;
  }
  .hero:not([data-mode='static']) .scrollHint {
    bottom: 22px;
    z-index: 3;
  }

  @media (max-width: 920px) {
    .heroGrid {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .hero:not([data-mode='static']) {
      height: 300vh;
    }
    .finale {
      top: 12%;
      width: auto;
      right: var(--gutter);
      transform: translateY(20px);
    }
    .finale.show {
      transform: none;
    }
    .hero:not([data-mode='static']) h1 {
      font-size: clamp(48px, 13vw, 84px);
    }
    .hero:not([data-mode='static']) .heroLead {
      font-size: 17px;
    }
  }
  @media (max-width: 620px) {
    .stamp {
      font-size: 10px;
    }
    /* Handy: Bild kleiner, damit gleich darunter die Fakten und Termine sichtbar werden */
    .heroSticky {
      padding-block: 24px 8px;
    }
    h1 {
      margin: 12px 0 18px;
    }
    .heroLead {
      font-size: 17px;
      margin-bottom: 22px;
    }
    .heroActions {
      display: grid;
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .heroActions .btn {
      justify-content: center;
    }
    /* Handy: Pizza gross und rechts angeschnitten – der Blickfang im ersten Bildschirm */
    .heroStatic {
      min-height: 0;
      aspect-ratio: 1 / 0.92;
    }
    .pizzaWrap {
      width: 106%;
      right: -28%;
      top: -5%;
    }
    .heroLogo {
      width: 31%;
      left: 0;
      bottom: -3%;
    }
    .hero:not([data-mode='static']) .veil {
      width: 100%;
      background: linear-gradient(180deg, rgba(243, 238, 228, 0.92) 0%, rgba(243, 238, 228, 0.85) 55%, rgba(243, 238, 228, 0) 80%);
    }
  }
</style>
