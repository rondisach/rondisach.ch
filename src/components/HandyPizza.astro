---
// Handy-Einstieg (bis 760px Breite) statt des grossen 3D-Gartens: ruhig und einfach.
// Titel, darunter eine Pizza in 3D – aus dem Foto berechnet, mit aufgewölbtem Rand und Belag –, die sich langsam dreht.
// Mit dem Finger lässt sie sich drehen, Antippen zeigt die nächste Sorte aus pizzen.json. Darunter der Anfrage-Knopf.
// Szene: src/scripts/handy/pizzaScene.ts (wird nur auf dem Handy geladen).
// Ohne WebGL oder bei reduzierter Bewegung: einfach das Foto der ersten Pizza.
import { Image, getImage } from 'astro:assets';
import pizzen from '../data/pizzen.json';
import { upload } from '../lib/images';

const sorten = pizzen.pizzas.map((p) => ({ name: p.name, img: upload(p.image) })).filter((s) => s.img);
const srcs = await Promise.all(sorten.map((s) => getImage({ src: s.img!, width: 768, format: 'webp' }).then((r) => r.src)));
const erste = sorten[0];
---

<section class="hp" aria-label="Einleitung" data-srcs={JSON.stringify(srcs)} data-names={JSON.stringify(sorten.map((s) => s.name))}>
  <div class="kicker">pizza catering · luzern</div>
  <h1>eifach e <span class="red">rondi</span> sach.</h1>

  <div class="stage">
    <canvas class="cv" aria-hidden="true"></canvas>
    {erste && <Image class="still" src={erste.img!} alt={`Pizza ${erste.name}`} widths={[420, 640]} sizes="84vw" loading="eager" />}
  </div>
  <p class="label" aria-live="polite">
    <span class="name">{erste?.name}</span>
    <span class="hint">antippen für die nächste</span>
  </p>

  <p class="lead">Handgemachte Pizza, frisch bei euch vor Ort gebacken.</p>
  <a class="btn" href="#anfrage" data-umami-event="Handy Pizza: anfragen">pizza anfragen</a>
</section>

<script>
  const root = document.querySelector<HTMLElement>('.hp');
  const phone = matchMedia('(max-width: 760px)').matches;
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const webgl = (() => {
    try {
      const c = document.createElement('canvas');
      return !!(c.getContext('webgl2') || c.getContext('webgl'));
    } catch {
      return false;
    }
  })();

  const active = (document.documentElement.dataset.handy || 'relief') === 'relief';
  if (root && active && phone && !still && webgl) init(root).catch(() => root.classList.remove('live'));

  async function init(root: HTMLElement) {
    const { createPizzaScene } = await import('../scripts/handy/pizzaScene');
    const srcs: string[] = JSON.parse(root.dataset.srcs || '[]');
    const names: string[] = JSON.parse(root.dataset.names || '[]');
    const canvas = root.querySelector<HTMLCanvasElement>('.cv')!;
    const name = root.querySelector<HTMLElement>('.name')!;

    // Zuerst einblenden, damit die Leinwand beim Start ihre richtige Grösse hat
    root.classList.add('live');
    const scene = createPizzaScene(canvas, srcs, (i) => {
      if (name.textContent !== names[i]) {
        name.textContent = names[i];
        name.animate([{ opacity: 0, transform: 'translateY(6px)' }, { opacity: 1, transform: 'none' }], { duration: 350, easing: 'ease-out' });
      }
    });

    // Beim Wegscrollen kippt die Pizza etwas (nur bei Änderung, über rAF gebündelt)
    let ticking = false;
    const update = () => {
      ticking = false;
      const rect = root.getBoundingClientRect();
      scene.setScroll(-rect.top / Math.max(1, rect.height));
    };
    addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();

    // Nur rendern, solange die Pizza sichtbar ist
    new IntersectionObserver(([e]) => (e.isIntersecting ? scene.start() : scene.stop())).observe(canvas);
  }
</script>

<style>
  .hp {
    display: none;
  }

  @media (max-width: 760px) {
    /* Auf dem Handy ersetzt dieser Einstieg den grossen 3D-Garten */
    :global(.hero) {
      display: none;
    }
    :global(html[data-handy='garten']) .hp {
      display: none;
    }
    .hp {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 22px var(--gutter) 36px;
      text-align: center;
    }
    .kicker {
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--muted);
    }
    h1 {
      margin: 8px 0 0;
      font-size: clamp(46px, 14vw, 76px);
      line-height: 0.9;
      letter-spacing: -0.065em;
    }
    .red {
      color: var(--accent);
    }

    .stage {
      position: relative;
      width: calc(100% + var(--gutter) * 2);
      aspect-ratio: 1 / 0.86;
      margin-top: 6px;
    }
    .cv {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: none;
    }
    .still {
      position: absolute;
      left: 50%;
      top: 50%;
      width: 78%;
      transform: translate(-50%, -50%);
      filter: drop-shadow(0 14px 16px rgba(60, 35, 20, 0.22));
    }
    .hp:global(.live) .cv {
      display: block;
    }
    .hp:global(.live) .still {
      display: none;
    }

    .label {
      margin: -4px 0 0;
      display: grid;
      gap: 2px;
    }
    .name {
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 24px;
      letter-spacing: -0.04em;
    }
    .hint {
      display: none;
      font-size: 13px;
      color: var(--muted);
    }
    .hp:global(.live) .hint {
      display: block;
    }

    .lead {
      margin: 18px 0 20px;
      font-size: 17px;
      line-height: 1.45;
      color: var(--ink-2);
    }
    .btn {
      width: 100%;
      min-height: 56px;
      font-size: 17px;
    }
  }
</style>
