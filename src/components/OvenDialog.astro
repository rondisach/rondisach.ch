---
import kontakt from '../data/kontakt.json';
import preise from '../data/preise.json';

interface Props {
  /** Abschnitt, zu dem die Seite nach dem Danke-Popup springt. */
  anchor: string;
  /** Seite, auf die FormSubmit nach dem Senden zurückleitet. */
  returnTo?: string;
}
const { anchor, returnTo = '/' } = Astro.props;
const diy = preise.diy;
---

<dialog class="ovenDialog" id="ofen-anfrage" aria-labelledby="oven-title" data-anchor={anchor}>
  <button class="dialogClose" type="button" data-close-oven aria-label="Schliessen"></button>
  <div class="kicker">ofen mieten</div>
  <h2 class="ovenTitle" id="oven-title">selber backen.</h2>
  <form action={`https://formsubmit.co/${kontakt.email}`} method="POST" class="form ovenForm">
    <input type="hidden" name="_subject" value="Neue Ofenmiete-Anfrage über rondisach.ch" />
    <input type="hidden" name="_template" value="table" />
    <input type="hidden" name="_next" value={`https://rondisach.ch${returnTo}?ofen=gesendet#${anchor}`} />
    <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />
    <label class="mFull">Name<input name="name" placeholder="Vor- und Nachname" autocomplete="name" required /></label>
    <label class="mFull">E-Mail<input name="email" type="email" placeholder="name@beispiel.ch" autocomplete="email" required /></label>
    <label>Telefon<input name="phone" type="tel" placeholder="+41 …" autocomplete="tel" /></label>
    <label>Öfen
      <select name="ovens">
        <option>1 Ofen</option>
        <option>2 Öfen</option>
      </select>
    </label>
    <label>Datum<input name="date" type="date" required /></label>
    <label>Dauer
      <select name="duration">
        <option>1 Tag</option>
        <option>Wochenende (Fr–Mo)</option>
        <option>Länger, siehe Nachricht</option>
      </select>
    </label>
    <label class="full">Übergabe
      <select name="handover">
        <option>Abholung in Kriens (kostenlos)</option>
        <option>Lieferung in Luzern (CHF 60 + Rückholung CHF 60)</option>
      </select>
    </label>
    <label class="full" data-address hidden>Lieferadresse<input name="address" placeholder="Strasse, PLZ, Ort" autocomplete="street-address" /></label>
    <label class="full">Pizzateig (Ballen)<input name="dough" type="number" inputmode="numeric" min="0" step="1" placeholder={`leer lassen oder ab ${diy.minDough}`} data-min={diy.minDough} /></label>
    <label class="full">Nachricht<textarea name="message" placeholder="Anlass, ungefähre Anzahl Personen, Fragen …"></textarea></label>
    <label class="check full"><input type="checkbox" name="datenschutz" value="gelesen" required /><span>Ich habe die <a href="/datenschutz.html">Datenschutzerklärung</a> zur Kenntnis genommen.</span></label>
    <button class="btn btn--light full" type="submit">ofen-anfrage senden</button>
    <p class="formHint full">Noch keine Buchung: Wir prüfen die Verfügbarkeit und bestätigen euch die Miete schriftlich. Teig bitte mindestens 3 Tage im Voraus bestellen.</p>
  </form>
  <p class="ovenDone" hidden role="status">Danke! Eure Anfrage für den Ofen ist bei uns angekommen. Wir melden uns so bald wie möglich.</p>
</dialog>

<script>
  import { track, trackPage } from '../lib/umami';

  const ovenDialog = document.getElementById('ofen-anfrage') as HTMLDialogElement | null;
  if (ovenDialog) {
    const ovenForm = ovenDialog.querySelector('form')!;
    const handover = ovenForm.querySelector<HTMLSelectElement>('select[name="handover"]')!;
    const addressLabel = ovenForm.querySelector<HTMLElement>('[data-address]')!;
    const address = addressLabel.querySelector('input')!;
    const dough = ovenForm.querySelector<HTMLInputElement>('input[name="dough"]')!;
    const minDough = Number(dough.dataset.min);
    const dateField = ovenForm.querySelector<HTMLInputElement>('input[type="date"]')!;

    document.querySelectorAll('[data-open-oven]').forEach((b) =>
      b.addEventListener('click', () => {
        ovenDialog.showModal();
        trackPage('/ofen-anfrage', 'Ofenmiete · Anfrage-Formular');
      }),
    );
    ovenDialog.querySelector('[data-close-oven]')!.addEventListener('click', () => ovenDialog.close());
    // Klick auf den abgedunkelten Hintergrund schliesst das Popup
    ovenDialog.addEventListener('click', (e) => {
      if (e.target === ovenDialog) ovenDialog.close();
    });

    // Lieferadresse nur bei Lieferung abfragen
    const syncAddress = () => {
      const delivery = handover.value.startsWith('Lieferung');
      addressLabel.hidden = !delivery;
      address.required = delivery;
    };
    handover.addEventListener('change', syncAddress);
    syncAddress();

    // Teig: leer lassen oder Mindestmenge
    dough.addEventListener('input', () => {
      const n = Number(dough.value);
      dough.setCustomValidity(dough.value && n > 0 && n < minDough ? `Teig gibt es ab ${minDough} Ballen.` : '');
    });

    const now = new Date();
    dateField.min = new Date(now.getTime() - now.getTimezoneOffset() * 60000).toISOString().slice(0, 10);

    // Zurück von FormSubmit: Danke-Popup zeigen
    if (new URLSearchParams(location.search).get('ofen') === 'gesendet') {
      const anchor = ovenDialog.dataset.anchor || '';
      track('Ofen-Anfrage gesendet');
      trackPage('/ofen-anfrage-gesendet', 'Ofenmiete · Anfrage gesendet');
      ovenForm.hidden = true;
      ovenDialog.querySelector<HTMLElement>('.ovenDone')!.hidden = false;
      ovenDialog.showModal();
      // Nach dem Schliessen zum Abschnitt springen (kurz verzögert, wenn die Seite wieder scrollbar ist)
      ovenDialog.addEventListener(
        'close',
        () =>
          setTimeout(() => {
            const target = document.getElementById(anchor);
            if (target) window.scrollTo({ top: target.getBoundingClientRect().top + window.scrollY - 90 });
          }),
        { once: true },
      );
      history.replaceState({}, document.title, location.pathname + '#' + anchor);
    }
  }
</script>

<style>
  /* Ofenmiete-Popup: gleiche Farben wie das Anfrageformular */
  .ovenDialog {
    width: min(640px, calc(100% - 32px));
    max-height: calc(100dvh - 32px);
    margin: auto;
    padding: clamp(24px, 4vw, 40px);
    border: 0;
    border-radius: 28px;
    background: var(--accent);
    color: #fff;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .ovenDialog::backdrop {
    background: rgba(18, 18, 18, 0.6);
    backdrop-filter: blur(4px);
  }
  :global(html:has(dialog[open])) {
    overflow: hidden;
  }
  .ovenDialog .kicker {
    color: var(--accent-ink);
  }
  .ovenTitle {
    font-size: clamp(36px, 5vw, 48px);
    line-height: 0.95;
    margin: 6px 0 18px;
  }
  .dialogClose {
    position: absolute;
    top: 18px;
    right: 18px;
    width: 44px;
    height: 44px;
    border: 1.5px solid #fff;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
  }
  .dialogClose::before,
  .dialogClose::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 18px;
    height: 2px;
    background: #fff;
    border-radius: 2px;
    transform: translate(-50%, -50%) rotate(45deg);
  }
  .dialogClose::after {
    transform: translate(-50%, -50%) rotate(-45deg);
  }
  .dialogClose:hover {
    background: rgba(255, 255, 255, 0.15);
  }
  .ovenForm {
    gap: 10px;
  }
  .ovenForm textarea {
    min-height: 80px;
  }
  .ovenForm .formHint {
    color: var(--accent-ink);
    margin: 0;
  }
  .ovenForm[hidden],
  .ovenForm label[hidden] {
    display: none;
  }
  .ovenDone {
    font-size: 18px;
    font-weight: 700;
    margin: 0;
  }
  @media (max-width: 620px) {
    .ovenDialog {
      width: 100%;
      max-width: none;
      max-height: 100dvh;
      height: 100dvh;
      border-radius: 0;
      padding: 24px 16px 32px;
    }
    .ovenDialog:has(.ovenDone:not([hidden])) {
      width: calc(100% - 32px);
      height: fit-content;
      border-radius: 24px;
      padding: 24px 20px 28px;
    }
    .dialogClose {
      top: 14px;
      right: 14px;
    }
  }
</style>
