---
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { albums, formatMonth } from '../lib/albums';
import { upload } from '../lib/images';
import rezensionen from '../data/rezensionen.json';

const prepared = await Promise.all(
  albums.map(async (album) => ({
    ...album,
    month: formatMonth(album.date),
    photos: await Promise.all(
      album.photos
        .map((p) => ({ ...p, src: upload(p.image) }))
        .filter((p) => p.src)
        .map(async (p) => ({ ...p, full: (await getImage({ src: p.src!, width: 1800, format: 'webp' })).src })),
    ),
  })),
);

const photoCount = prepared.reduce((sum, a) => sum + a.photos.length, 0);
const pad = (n: number) => String(n).padStart(2, '0');
---

<Layout title="Impressionen | rondisach Pizza Catering" description="Bilder von vergangenen Anlässen mit rondisach Pizza Catering in Luzern und Umgebung.">
  <header class="wrap pageHead">
    <div class="kicker">impressionen</div>
    {
      prepared.length > 0 ? (
        <>
          <h1 class="statement">Kein Anlass ist wie der andere. Was immer gleich bleibt: frischer Teig, ein heisser Ofen und Pizza, bis alle satt sind.</h1>
          <p class="facts">
            <span>{prepared.length} {prepared.length === 1 ? 'Anlass' : 'Anlässe'}</span>
            <span>{photoCount} Bilder</span>
            {rezensionen.count > 0 && <span>{rezensionen.rating.toFixed(1)} auf Google · {rezensionen.count} Bewertungen</span>}
          </p>
        </>
      ) : (
        <>
          <h1 class="title">so war's bei euch.</h1>
          <p class="lead">Hier zeigen wir bald Bilder von unseren Anlässen – vom Aufbau über den ersten Teig bis zur letzten Pizza. Wir sind gerade dabei, die schönsten Momente zusammenzustellen. Schaut also bald wieder vorbei!</p>
        </>
      )
    }
  </header>

  <div class="wrap albums" hidden={prepared.length === 0}>
    {
      prepared.map((album, n) => {
        const [hero, ...rest] = album.photos;
        return (
          <>
            <section class:list={['album', { flip: n % 2 === 1 }]} id={album.slug} aria-labelledby={`${album.slug}-title`}>
              <div class="refMain">
                {hero && (
                  <button type="button" class="thumb refHero" data-full={hero.full} data-alt={hero.alt ?? ''} aria-label={`Bild 1 gross anzeigen${hero.alt ? `: ${hero.alt}` : ''}`}>
                    <Image src={hero.src!} alt={hero.alt ?? ''} widths={[640, 960, 1300]} sizes="(max-width: 920px) 100vw, 680px" />
                  </button>
                )}
                <div class="refText">
                  <span class="refNo" aria-hidden="true">{pad(n + 1)}</span>
                  <h2 id={`${album.slug}-title`}>
                    {album.title}
                    {album.guests ? <span class="guests"> – {album.guests} Gäste</span> : null}
                  </h2>
                  {album.month && <p class="meta">{album.month}</p>}
                  {album.description && <p class="story">{album.description}</p>}
                  {album.quote && (
                    <blockquote class="refQuote">
                      <p>«{album.quote}»</p>
                      {album.quoteBy && <cite>{album.quoteBy}</cite>}
                    </blockquote>
                  )}
                  <p class="count">{album.photos.length} Bilder</p>
                </div>
              </div>
              {rest.length > 0 && (
                <ul class="strip" style={`--cols: ${Math.ceil(rest.length / Math.ceil(rest.length / 4))}`}>
                  {rest.map((p, i) => (
                    <li>
                      <button type="button" class="thumb" data-full={p.full} data-alt={p.alt ?? ''} aria-label={`Bild ${i + 2} gross anzeigen${p.alt ? `: ${p.alt}` : ''}`}>
                        <Image src={p.src!} alt={p.alt ?? ''} widths={[360, 640]} sizes="(max-width: 620px) 50vw, 280px" />
                      </button>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          </>
        );
      })
    }
  </div>

  <div class="wrap cta">
    <h2>euer anlass als nächstes?</h2>
    <a class="btn" href="/#anfrage">pizza anfragen</a>
  </div>

  <dialog class="lightbox" aria-label="Bildansicht">
    <img alt="" />
    <p class="caption"></p>
    <button type="button" class="lbBtn lbClose" aria-label="Schliessen">✕</button>
    <button type="button" class="lbBtn lbPrev" aria-label="Vorheriges Bild">←</button>
    <button type="button" class="lbBtn lbNext" aria-label="Nächstes Bild">→</button>
  </dialog>
</Layout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox')!;
  const img = dialog.querySelector('img')!;
  const caption = dialog.querySelector<HTMLElement>('.caption')!;
  let group: HTMLButtonElement[] = [];
  let index = 0;

  function show(i: number) {
    index = (i + group.length) % group.length;
    const btn = group[index];
    img.src = btn.dataset.full!;
    img.alt = btn.dataset.alt || '';
    caption.textContent = `${btn.dataset.alt ? btn.dataset.alt + ' · ' : ''}${index + 1} / ${group.length}`;
  }

  document.querySelectorAll<HTMLButtonElement>('.thumb').forEach((btn) => {
    btn.addEventListener('click', () => {
      group = Array.from(btn.closest('.album')!.querySelectorAll<HTMLButtonElement>('.thumb'));
      show(group.indexOf(btn));
      dialog.showModal();
    });
  });

  dialog.querySelector('.lbClose')!.addEventListener('click', () => dialog.close());
  dialog.querySelector('.lbPrev')!.addEventListener('click', () => show(index - 1));
  dialog.querySelector('.lbNext')!.addEventListener('click', () => show(index + 1));
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(index - 1);
    if (e.key === 'ArrowRight') show(index + 1);
  });

  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Bilder öffnen sich beim Hineinscrollen wie ein Vorhang, Texte gleiten nach oben.
  if (!calm && 'IntersectionObserver' in window) {
    const items = document.querySelectorAll<HTMLElement>('.refHero, .strip li, .refText');
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-in');
          io.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -12% 0px' },
    );
    items.forEach((el) => {
      // Bilder einer Reihe nacheinander öffnen
      const li = el.closest('li');
      if (li) el.style.setProperty('--d', `${Array.from(li.parentElement!.children).indexOf(li) * 90}ms`);
      el.classList.add('reveal');
      io.observe(el);
    });
  }

  // Wischen auf dem Handy
  let startX = 0;
  dialog.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
  dialog.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - startX;
    if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
  });
</script>

<style>
  .pageHead {
    padding-block: clamp(48px, 8vw, 104px) clamp(40px, 6vw, 72px);
  }
  .pageHead .lead {
    margin-top: 20px;
  }
  /* Grosser Satz statt Einleitung */
  .statement {
    max-width: 21em;
    margin: 18px 0 0;
    font-family: var(--font-display);
    font-size: clamp(30px, 4.3vw, 58px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    margin: clamp(24px, 3vw, 36px) 0 0;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .albums {
    display: grid;
    gap: clamp(72px, 10vw, 128px);
  }

  /* Ein Anlass: grosses Bild und Text nebeneinander, jedes zweite Mal gespiegelt */
  .refMain {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }
  .flip .refHero {
    order: 2;
  }
  .refHero {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
  }
  .refNo {
    display: block;
    margin-bottom: 14px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--accent);
  }
  .refText h2 {
    font-size: clamp(30px, 3.6vw, 48px);
    line-height: 1;
    margin: 0;
  }
  .guests {
    color: var(--muted);
  }
  .meta {
    margin: 12px 0 0;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .story {
    margin: 18px 0 0;
    max-width: 34em;
  }
  .refQuote {
    margin: 24px 0 0;
    padding-left: 18px;
    border-left: 2px solid var(--accent);
  }
  .refQuote p {
    margin: 0;
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.25;
  }
  .refQuote cite {
    display: block;
    margin-top: 8px;
    font-size: 13px;
    font-style: normal;
    color: var(--muted);
  }
  .count {
    margin: 24px 0 0;
    font-size: 13px;
    color: var(--muted);
  }

  /* Weitere Bilder in vollen Reihen: Bilder der letzten Reihe werden breiter statt Lücken zu lassen */
  .strip {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: clamp(16px, 2vw, 24px) 0 0;
    padding: 0;
    list-style: none;
  }
  .strip li {
    flex: 1 1 calc((100% - (var(--cols) - 1) * 12px) / var(--cols));
  }
  .strip .thumb {
    height: clamp(150px, 17vw, 220px);
  }

  .thumb {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--radius-sm);
    overflow: hidden;
    cursor: pointer;
    background: var(--panel);
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  /* Vorhang: Bild startet beschnitten und leicht vergrössert, öffnet sich dann */
  .reveal.refHero,
  .strip li.reveal {
    clip-path: inset(14% 10% 14% 10% round var(--radius-sm));
    transition: clip-path 1.2s cubic-bezier(0.2, 0.8, 0.2, 1) var(--d, 0ms);
  }
  .reveal.refHero img,
  .strip li.reveal img {
    transform: scale(1.18);
    transition: transform 1.6s cubic-bezier(0.2, 0.8, 0.2, 1) var(--d, 0ms);
  }
  .reveal.is-in.refHero,
  .strip li.reveal.is-in {
    clip-path: inset(0 0 0 0 round var(--radius-sm));
  }
  .reveal.is-in.refHero img,
  .strip li.reveal.is-in img {
    transform: none;
  }
  .refText.reveal {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.9s ease 0.15s,
      transform 1s cubic-bezier(0.2, 0.8, 0.2, 1) 0.15s;
  }
  .refText.reveal.is-in {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 920px) {
    .refMain {
      grid-template-columns: 1fr;
    }
    .flip .refHero {
      order: 0;
    }
  }
  @media (max-width: 620px) {
    .strip {
      gap: 8px;
    }
    .strip li {
      flex-basis: calc(50% - 4px);
    }
    .strip .thumb {
      height: 34vw;
    }
    .thumb {
      border-radius: 12px;
    }
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: clamp(64px, 9vw, 112px);
    padding: clamp(24px, 4vw, 40px);
    border-radius: var(--radius);
    background: var(--ink);
    color: var(--cream);
  }
  .cta h2 {
    font-size: clamp(32px, 4vw, 52px);
  }
  .cta .btn {
    background: var(--cream);
    color: var(--ink);
    border-color: var(--cream);
  }

  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 56px 16px 64px;
    border: 0;
    background: rgba(18, 18, 18, 0.94);
    color: var(--cream);
  }
  .lightbox[open] {
    display: grid;
    place-items: center;
  }
  .lightbox::backdrop {
    background: transparent;
  }
  .lightbox img {
    max-width: 100%;
    max-height: calc(100dvh - 140px);
    object-fit: contain;
    border-radius: 8px;
  }
  .caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 20px;
    margin: 0;
    text-align: center;
    font-size: 14px;
    color: #cfc8bd;
  }
  .lbBtn {
    position: absolute;
    width: 48px;
    height: 48px;
    border: 1.5px solid rgba(243, 238, 228, 0.5);
    border-radius: 50%;
    background: rgba(18, 18, 18, 0.6);
    color: var(--cream);
    font-size: 20px;
    cursor: pointer;
  }
  .lbClose {
    top: 12px;
    right: 12px;
  }
  .lbPrev,
  .lbNext {
    top: 50%;
    transform: translateY(-50%);
  }
  .lbPrev {
    left: 12px;
  }
  .lbNext {
    right: 12px;
  }
</style>
